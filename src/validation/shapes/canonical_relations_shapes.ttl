:CanonicalSuggest_applicable_geographic_place_to_applies_to_jurisdiction a sh:NodeShape ;
  sh:targetSubjectsOf :applicable_geographic_place ;
  sh:severity sh:Info ;
  sh:sparql [
    sh:message """{"type": "SUGGEST_RELATIONS", "detected": "applicable geographic place", "canonical": "applies to jurisdiction", "suggest": ["applies_to_jurisdiction"]}""" ;
    sh:select """
PREFIX : <http://example.org/family/>
SELECT $this ?path ?value WHERE {
  $this :applicable_geographic_place ?value .
  BIND(:applicable_geographic_place AS ?path)
}
    """ ;
  ] .

