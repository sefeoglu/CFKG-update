:CanonicalSuggest_sibling_of_to_sibling a sh:NodeShape ;
  sh:targetSubjectsOf :sibling_of ;
  sh:severity sh:Info ;
  sh:sparql [
    sh:message """{"type": "SUGGEST_RELATIONS", "detected": "sibling of", "canonical": "sibling", "suggest": ["sibling"]}""" ;
    sh:select """
PREFIX : <http://example.org/family/>
SELECT $this ?path ?value WHERE {
  $this :sibling_of ?value .
  BIND(:sibling_of AS ?path)
}
    """ ;
  ] .

