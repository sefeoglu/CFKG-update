@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix :    <http://example.org/family/> .

################################################
# Suggest canonical: "belonged to" -> "owned by"
################################################
:CanonicalSuggest_belonged_to_to_owned_by a sh:NodeShape ;
  sh:targetSubjectsOf :belonged_to ;
  sh:severity sh:Info ;
  sh:sparql [
    sh:message """{"type": "SUGGEST_RELATIONS", "detected": "belonged to", "canonical": "owned by", "suggest": ["owned_by"]}""" ;
    sh:select """
PREFIX : <http://example.org/family/>
SELECT $this ?path ?value WHERE {
  $this :belonged_to ?value .
  BIND(:belonged_to AS ?path)
}
    """ ;
  ] .

################################################
# Suggest canonical: "belongs to" -> "owned by"
################################################
