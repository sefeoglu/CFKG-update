@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix :  <http://example.org/relations/> .

################################################
# Inverse-set suggestion constraints
# Rule: if relation R is detected, suggest ONLY the other relations in the SAME list.
################################################

########## ["follows", "followed_by"] ##########

:Suggest_follows__set1 a sh:NodeShape ;
  sh:targetSubjectsOf :follows ;
  sh:severity sh:Info ;
  sh:sparql [
    sh:message """{"type":"SUGGEST_RELATIONS","detected":"follows","suggest":["followed_by"]}""" ;
    sh:select """
PREFIX : <http://example.org/relations/>
SELECT $this ?path ?value WHERE {
  $this :follows ?value .
  BIND(:follows AS ?path)
}
""" ;
  ] .

:Suggest_followed_by__set1 a sh:NodeShape ;
  sh:targetSubjectsOf :followed_by ;
  sh:severity sh:Info ;
  sh:sparql [
    sh:message """{"type":"SUGGEST_RELATIONS","detected":"followed_by","suggest":["follows"]}""" ;
    sh:select """
PREFIX : <http://example.org/relations/>
SELECT $this ?path ?value WHERE {
  $this :followed_by ?value .
  BIND(:followed_by AS ?path)
}
""" ;
  ] .

